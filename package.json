{
  "name": "daily-news-bot",
  "version": "1.0.0",
  "private": true,
  "description": "每日新闻简报自动化：dsh-rss-digest 抓取 RSS → DeepSeek 摘要 → 飞书推送（GitHub Actions 定时 08:00 北京时间）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "add-sources": "node scripts/add-sources.mjs",
    "fetch": "dsh-rss-digest fetch --db ./store.json",
    "digest": "dsh-rss-digest digest --db ./store.json --lang zh --out digest.md --timezone Asia/Shanghai",
    "send-feishu": "node scripts/send-feishu.mjs digest.md"
  },
  "dependencies": {
    "dsh-rss-digest": "^0.1.0"
  }
}
